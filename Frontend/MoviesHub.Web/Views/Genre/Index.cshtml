@model IEnumerable<MoviesHub.Web.Models.GenreDto>

@{
    ViewData["Title"] = "Genres";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Genre List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Genre" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Create New Genre
            </a>
        </div>
    </div>
    <br />

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var genre in Model)
                {
                    <tr>
                        <td>@genre.Id</td>
                        <td>@genre.Name</td>
                        <td>
                            <div class="w-100 btn-group" role="group">
                                <a asp-controller="Genre" asp-action="Edit" asp-route-id="@genre.Id" class="btn btn-primary mx-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-controller="Genre" asp-action="Delete" asp-route-id="@genre.Id" class="btn btn-danger mx-1">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                                <a asp-controller="Genre" asp-action="Movies" asp-route-id="@genre.Id" class="btn btn-success mx-1">
                                    <i class="bi bi-film"></i> Movies
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No genres found</td>
                </tr>
            }
        </tbody>
    </table>
</div>