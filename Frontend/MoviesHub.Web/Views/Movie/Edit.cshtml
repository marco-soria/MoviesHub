@model MovieUpdateDto
@{
    ViewData["Title"] = "Editar Película";
}

<h1>Editar Película</h1>

<div class="row">
    <div class="col-md-8 offset-md-2">
        <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Título</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseYear" class="form-label">Año de Estreno</label>
                <input asp-for="ReleaseYear" class="form-control" type="number" />
                <span asp-validation-for="ReleaseYear" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">URL de Imagen</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Géneros</label>
                <div class="row">
                    @foreach (var genre in ViewBag.Genres)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="GenreIds" value="@genre.Id"
                                @(Model.GenreIds != null && Model.GenreIds.Contains(genre.Id) ? "checked" : "") />
                                <label class="form-check-label">@genre.Name</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
