@model IEnumerable<MoviesHub.Web.Models.MovieDto>
@{
    ViewData["Title"] = "Movies by Genre";
    var genres = ViewBag.Genres as List<MoviesHub.Web.Models.GenreDto>;
    var selectedGenreId = ViewBag.GenreId != null ? (int)ViewBag.GenreId : 0;
}
<div class="container p-3">
    <div class="row">
        <div class="col-12">
            <h2 class="text-primary">Select a Genre</h2>
            <form asp-controller="Movie" asp-action="ByGenre" method="get" class="mb-4" id="genreForm">
                <div class="input-group">
                    <select name="genreId" id="genreSelect" class="form-select" aria-label="Genre selection" onchange="this.form.submit()">
                        <option value="0" selected="@(selectedGenreId == 0)">All Movies</option>
                        @if (genres != null && genres.Any())
                        {
                            @foreach (var genre in genres)
                            {
                                if (selectedGenreId == genre.Id)
                                {
                                    <option value="@genre.Id" selected>@genre.Name</option>
                                }
                                else
                                {
                                    <option value="@genre.Id">@genre.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
    <hr />
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">
                @if (selectedGenreId == 0)
                {
                    <span>All Movies</span>
                }
                else
                {
                    <span>Movies in Selected Genre</span>
                }
            </h2>
        </div>
    </div>
    <br />
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var movie in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(movie.ImageUrl))
                        {
                            <img src="@movie.ImageUrl" class="card-img-top" alt="@movie.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex justify-content-center align-items-center" style="height: 200px;">
                                <span class="text-muted">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@movie.Title</h5>
                            <p class="card-text"><small class="text-muted">Release Year: @movie.ReleaseYear</small></p>
                            <p class="card-text">
                                <span class="badge bg-warning">Rating: @movie.AverageRating</span>
                            </p>
                        </div>
                        <div class="card-footer">
                            <div class="btn-group w-100" role="group">
                                <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-info">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            @if (selectedGenreId == 0)
            {
                <span>No movies available in the database.</span>
            }
            else
            {
                <span>No movies found for this genre.</span>
            }
        </div>
    }
</div>