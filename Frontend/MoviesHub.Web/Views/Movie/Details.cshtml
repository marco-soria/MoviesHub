@model MovieDetailsViewModel
@{
    ViewData["Title"] = Model.Movie?.Title ?? "Detalles de Película";

    // Verificación robusta de autenticación
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    string userId = null;
    bool isAdmin = false;
    bool isManager = false;

    if (isAuthenticated)
    {
        userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        // Si no hay userId válido, consideramos que no está autenticado realmente
        isAuthenticated = !string.IsNullOrEmpty(userId);

        // Verificar roles para autorización
        isAdmin = User.IsInRole(MoviesHub.Web.Utility.SD.RoleAdmin);
        isManager = User.IsInRole(MoviesHub.Web.Utility.SD.RoleManager);
    }

    bool hasUserReview = ViewBag.UserReview != null;
    ReviewDto userReview = ViewBag.UserReview as ReviewDto;
    bool userHasDeletedReview = ViewBag.UserHasDeletedReview == true;

    // Guardar el rating original para mostrar en "Average Rating" (consistente con Home)
    decimal storedRating = Model.Movie?.AverageRating ?? 0;
}

@if (Model.Movie != null)
{
    <div class="container mt-4">
        <div class="row">
            <!-- Columna para la imagen -->
            <div class="col-md-4">
                <img src="@Model.Movie.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Movie.Title" onerror="this.src='/images/placeholder.jpg'">

                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Rating</h5>

                        <!-- Rating calculado de las reseñas actuales (único rating que se mostrará) -->
                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            decimal calculatedRating = (decimal)Math.Round(Model.Reviews.Average(r => r.Rating), 1);
                            <div class="mb-3">
                                <small class="text-muted">Average Rating (@Model.Reviews.Count reviews):</small>
                                <div class="d-flex align-items-center">
                                    <div class="rating me-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            double convertedRating = Convert.ToDouble(calculatedRating) / 2;
                                            if (i <= Math.Round(convertedRating))
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else if (i - 0.5 <= convertedRating)
                                            {
                                                <i class="bi bi-star-half text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }
                                    </div>
                                    <span class="fw-bold">@calculatedRating.ToString("0.0")/10</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <small class="text-muted">No ratings yet</small>
                                <div class="d-flex align-items-center">
                                    <div class="rating me-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    </div>
                                    <span class="fw-bold">0.0/10</span>
                                </div>
                            </div>
                        }

                        <!-- Rating del usuario actual (si existe) -->
                        @if (ViewBag.UserReview != null)
                        {
                            <div class="mb-3">
                                <small class="text-muted">Tu calificación:</small>
                                <div class="d-flex align-items-center">
                                    <div class="rating me-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            double convertedRating = Convert.ToDouble(ViewBag.UserReview.Rating) / 2;
                                            if (i <= Math.Round(convertedRating))
                                            {
                                                <i class="bi bi-star-fill text-success"></i>
                                            }
                                            else if (i - 0.5 <= convertedRating)
                                            {
                                                <i class="bi bi-star-half text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-success"></i>
                                            }
                                        }
                                    </div>
                                    <span class="fw-bold">@ViewBag.UserReview.Rating/10</span>
                                </div>
                            </div>
                        }

                        <hr>

                        <h5>Watched this movie?</h5>
                        <!-- En la sección de calificación -->
                        <div class="d-grid">
                            @if (hasUserReview)
                            {
                                <button class="btn btn-outline-success mb-2" data-bs-toggle="modal" data-bs-target="#editReviewModal">
                                    <i class="bi bi-pencil-square"></i> Edit your review
                                </button>
                                <form asp-action="DeleteReview" asp-controller="Movie" method="post" onsubmit="return confirm('Are you sure? This action cannot be undone.')">
                                    <input type="hidden" name="reviewId" value="@userReview.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100 mb-2">
                                        <i class="bi bi-trash"></i> Delete Review
                                    </button>
                                </form>
                            }
                            else if (isAuthenticated)
                            {
                                <button class="btn btn-outline-primary mb-2" data-bs-toggle="modal" data-bs-target="#rateModal">
                                    <i class="bi bi-star-fill"></i> Rate This Movie
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Movie", new { id = Model.Movie.Id })" class="btn btn-outline-primary mb-2">
                                    <i class="bi bi-star-fill"></i> Login to Rate
                                </a>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- Columna para la información de la película -->
            <div class="col-md-8">
                <h1 class="mb-2">@Model.Movie.Title</h1>
                <p class="text-muted">@Model.Movie.ReleaseYear</p>

                <div class="mb-4">
                    <h4>Synopsis</h4>
                    <p>@Model.Movie.Description</p>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h4>Genres</h4>
                        <p>
                            @if (Model.Movie.GenreNames != null && Model.Movie.GenreNames.Any())
                            {
                                @string.Join(", ", Model.Movie.GenreNames)
                            }
                            else
                            {
                                <span>No genre information</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h4>Release Year</h4>
                        <p>@Model.Movie.ReleaseYear</p>
                    </div>
                </div>

                <!-- Sección de reseñas -->
                <div class="mt-5">
                    <h3>Reseñas</h3>
                    <hr>

                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="card-title mb-0">@review.UserName</h5>
                                        <div class="d-flex align-items-center">
                                            <div class="rating me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    double convertedRating = Convert.ToDouble(review.Rating) / 2;
                                                    if (i <= Math.Round(convertedRating))
                                                    {
                                                        <i class="bi bi-star-fill text-warning"></i>
                                                    }
                                                    else if (i - 0.5 <= convertedRating)
                                                    {
                                                        <i class="bi bi-star-half text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-warning"></i>
                                                    }
                                                }
                                            </div>

                                            @* Admin/Manager controls for any review *@
                                            @if (isAdmin || isManager || (isAuthenticated && review.UserId == userId))
                                            {
                                                <div class="dropdown ms-2">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="reviewActions@(review.Id)" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="reviewActions@(review.Id)">
                                                        @if (review.UserId == userId || isAdmin || isManager)
                                                        {
                                                            <li>
                                                                <a href="#" class="dropdown-item edit-review-btn"
                                                                   data-review-id="@review.Id"
                                                                   data-review-comment="@review.Comment"
                                                                   data-review-rating="@review.Rating"
                                                                   data-movie-id="@Model.Movie.Id">
                                                                    <i class="bi bi-pencil"></i> Edit
                                                                </a>
                                                            </li>
                                                        }
                                                        <li>
                                                            <form asp-action="DeleteReview" asp-controller="Movie" method="post" class="d-inline m-0 p-0" onsubmit="return confirm('¿Are you sure to delete this review?')">
                                                                <input type="hidden" name="reviewId" value="@review.Id" />
                                                                <button type="submit" class="dropdown-item text-danger">
                                                                    <i class="bi bi-trash"></i> Delete
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }

                                        </div>
                                    </div>
                                    <p class="card-text">@review.Comment</p>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <p>No Reviews Available. Be the first one to make a review!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para calificar la película -->
    @if (isAuthenticated)
    {
        <div class="modal fade" id="rateModal" tabindex="-1" aria-labelledby="rateModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="rateModalLabel">Calificar @Model.Movie.Title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="AddReview" asp-controller="Movie" method="post">
                        <div class="modal-body">
                            <input type="hidden" name="MovieId" value="@Model.Movie.Id" />
                            <input type="hidden" name="UserId" value="@userId" />

                            <div class="mb-3">
                                <label for="Rating" class="form-label">Rating</label>
                                <select id="Rating" name="Rating" class="form-select">
                                    <option value="10">10 - Masterpiece</option>
                                    <option value="9">9 - Excelent</option>
                                    <option value="8">8 - Very Good</option>
                                    <option value="7">7 - Good</option>
                                    <option value="6">6 - Fine</option>
                                    <option value="5">5 - Average</option>
                                    <option value="4">4 - Bad</option>
                                    <option value="3">3 - Very Bad</option>
                                    <option value="2">2 - Horrible</option>
                                    <option value="1">1 - Appaling</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="Comment" class="form-label">Comentario</label>
                                <textarea id="Comment" name="Comment" class="form-control" rows="4" placeholder="Share your review of this movie..." required minlength="5"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Publish review</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Modal para editar reseña existente -->
    @if (hasUserReview)
    {
        <div class="modal fade" id="editReviewModal" tabindex="-1" aria-labelledby="editReviewModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editReviewModalLabel">Edita review of @Model.Movie.Title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="UpdateReview" asp-controller="Movie" method="post">
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@userReview.Id" />
                            <input type="hidden" name="movieId" value="@Model.Movie.Id" />
                            <input type="hidden" name="userId" value="@userId" />

                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <select id="rating" name="rating" class="form-select">
                                    @{
                                        var ratings = new[] {
                            (10, "Masterpiece"),
                            (9, "Excelent"),
                            (8, "Very Good"),
                            (7, "Good"),
                            (6, "Fine"),
                            (5, "Average"),
                            (4, "Bad"),
                            (3, "Very Bad"),
                            (2, "Horrible"),
                            (1, "Appaling")
                            };

                                        foreach (var (value, description) in ratings)
                                        {
                                            bool isSelected = userReview.Rating == value;
                                            if (isSelected)
                                            {
                                                <option value="@value" selected>@value - @description</option>
                                            }
                                            else
                                            {
                                                <option value="@value">@value - @description</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment</label>
                                <textarea id="comment" name="comment" class="form-control" rows="4" required minlength="5">@userReview.Comment</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Update Review</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Modal para editar cualquier reseña (admin/manager) -->
    @if (isAdmin || isManager)
    {
        <div class="modal fade" id="editAnyReviewModal" tabindex="-1" aria-labelledby="editAnyReviewModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editAnyReviewModalLabel">Edit review</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="UpdateReview" asp-controller="Movie" method="post" id="editAnyReviewForm">
                        <div class="modal-body">
                            <input type="hidden" id="adminEditReviewId" name="id" value="" />
                            <input type="hidden" id="adminEditMovieId" name="movieId" value="@Model.Movie.Id" />

                            <div class="mb-3">
                                <label for="adminEditRating" class="form-label">Rating</label>
                                <select id="adminEditRating" name="rating" class="form-select">
                                    <option value="10">10 - Masterpiece</option>
                                    <option value="9">9 - Excelent</option>
                                    <option value="8">8 - Very Good</option>
                                    <option value="7">7 - Good</option>
                                    <option value="6">6 - Fine</option>
                                    <option value="5">5 - Average</option>
                                    <option value="4">4 - Bad</option>
                                    <option value="3">3 - Very Bad</option>
                                    <option value="2">2 - Horrible</option>
                                    <option value="1">1 - Appaling</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="adminEditComment" class="form-label">Comment</label>
                                <textarea id="adminEditComment" name="comment" class="form-control" rows="4" required minlength="5"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Update Review</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="container mt-5">
        <div class="alert alert-warning">
            <h4>Movie not found</h4>
            <p>We are sorry we could not find the movie requested.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Return Home</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Función mejorada para cargar datos en el modal cuando se hace clic en Edit
            $('.edit-review-btn').on('click', function(event) {
                event.preventDefault();

                var reviewId = $(this).data('review-id');
                var reviewComment = $(this).data('review-comment');
                var reviewRating = $(this).data('review-rating');
                var movieId = $(this).data('movie-id');

                console.log("Edit clicked for review ID:", reviewId);

                // Asignar valores al formulario del modal
                $('#adminEditReviewId').val(reviewId);
                $('#adminEditMovieId').val(movieId);
                $('#adminEditComment').val(reviewComment);
                $('#adminEditRating').val(reviewRating);

                // Asegurar que el modal se abre correctamente
                var myModal = new bootstrap.Modal(document.getElementById('editAnyReviewModal'));
                myModal.show();
            });

            // Asegurar que los tooltips funcionan (si los hay)
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Ver en consola si se cargaron los listeners
            console.log("Script cargado, listeners de edit configurados en " + $('.edit-review-btn').length + " elementos");
        });
    </script>
}

}

