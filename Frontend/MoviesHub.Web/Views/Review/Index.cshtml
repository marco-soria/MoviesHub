@model IEnumerable<ReviewDto>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Review List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Review" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Review
            </a>
        </div>
    </div>
    <br />

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Movie ID</th>
                <th>User ID</th>
                <th>Comment</th>
                <th>Rating</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Id</td>
                    <td>@obj.MovieId</td>
                    <td>@obj.UserId</td>
                    <td>@obj.Comment</td>
                    <td>@obj.Rating</td>
                    <td>@obj.CreatedAt.ToShortDateString()</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Review" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a href="#" class="btn btn-danger mx-2" onclick="Delete(@obj.Id)">
                                <i class="bi bi-trash3"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this review?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    <input type="hidden" id="reviewIdToDelete" name="id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function Delete(id) {
            document.getElementById("reviewIdToDelete").value = id;
            new bootstrap.Modal(document.getElementById('deleteConfirmationModal')).show();
        }
    </script>
}
