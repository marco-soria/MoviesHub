@model List<MoviesHub.Web.Models.MovieGenreDto>
@{
    ViewData["Title"] = "Movie-Genre Associations";
}
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Movie-Genre Associations</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="MovieGenre" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Association
                </a>
            </div>
        </div>

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["error"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">
                No movie-genre associations found.
            </div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Genre</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var obj in Model)
                    {
                        <tr>
                            <td>@obj.MovieTitle</td>
                            <td>@obj.GenreName</td>
                            <td>
                                <div class="w-75 btn-group" role="group">
                                    <a asp-controller="MovieGenre" asp-action="MovieGenres" asp-route-movieId="@obj.MovieId"
                                       class="btn btn-info mx-2">
                                        <i class="bi bi-film"></i> View Movie Genres
                                    </a>
                                    <a asp-controller="MovieGenre" asp-action="GenreMovies" asp-route-genreId="@obj.GenreId"
                                       class="btn btn-primary mx-2">
                                        <i class="bi bi-collection"></i> View Genre Movies
                                    </a>
                                    <a asp-controller="MovieGenre" asp-action="Delete"
                                       asp-route-movieId="@obj.MovieId" asp-route-genreId="@obj.GenreId"
                                       class="btn btn-danger mx-2">
                                        <i class="bi bi-trash-fill"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>